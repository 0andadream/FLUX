# WalletConnect Cloud project id. Injected wallets work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional Celo RPC. Defaults to https://forno.celo.org
NEXT_PUBLIC_CELO_RPC=

# Optional ERC-8021 code. Defaults to the code for flux.celo.app.
NEXT_PUBLIC_ATTRIBUTION_TAG=

# Optional. After you register, set this so /agent-registration.json lists the agent id.
NEXT_PUBLIC_AGENT_ID=

# Optional. Server-only. The agent page uses Grok when this is set.
XAI_API_KEY=
